# Starting point for production .env - copy to .env on the server and fill
# in every value marked CHANGE ME. Everything else is a sane production
# default already explained inline.

APP_NAME="FPM Tax App"
APP_ENV=production
APP_KEY=                      # CHANGE ME - generate with: php artisan key:generate
APP_DEBUG=false                # never true in production - leaks stack traces to users
APP_URL=https://CHANGE-ME.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                # debug/info are too noisy and may log sensitive request data

DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database         # required for Auth::logoutOtherDevices() to work
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true      # cookie only sent over HTTPS - requires APP_URL to be https
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Permanent file storage - Cloudflare R2. Keep the temp upload disk LOCAL
# (see below) even though permanent storage is R2 - see .env.example for
# why (Livewire does not support multi-file upload to an S3-backed disk).
FILESYSTEM_DISK=r2
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=CHANGE_ME
R2_ENDPOINT=CHANGE_ME           # e.g. https://<account-id>.r2.cloudflarestorage.com
R2_URL=CHANGE_ME                # public URL for the bucket, if applicable

# QUEUE_CONNECTION=database requires a queue worker running continuously
# in the background (e.g. via Supervisor) - FPM upload processing silently
# never completes without it:
#   php artisan queue:work --tries=1 --timeout=120
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log                 # CHANGE ME to smtp (or similar) if the app ever sends email

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Scheduled jobs ──────────────────────────────────────────────────────
# routes/console.php registers a daily cleanup of stale Livewire temp
# upload files. Laravel's scheduler needs ONE cron entry on the server
# pointing at this project, running every minute:
#   * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
